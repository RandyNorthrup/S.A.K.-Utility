# Turns text files into a C++ source of char arrays, so a script can stay a real file that a parser and
# the syntax gate read, and still reach the program with nothing beside it on disk that an unelevated
# process could change before an elevated PowerShell ran it.
#
# sak_embed_text_files(<output .cpp> <namespace> <file> <array name> [<file> <array name>...])
function(sak_embed_text_files output namespace)
    set(arrays "")
    set(remaining ${ARGN})
    while(remaining)
        list(POP_FRONT remaining file name)
        file(READ "${file}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND arrays "extern const char ${name}[];\nconst char ${name}[] = {${bytes}0};\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    endwhile()
    set(text "// Generated by cmake/embed_text_files.cmake. Do not edit.\nnamespace ${namespace} {\n${arrays}}\n")
    # Only when it changed, so a configure does not rebuild what uses it.
    set(current "")
    if(EXISTS "${output}")
        file(READ "${output}" current)
    endif()
    if(NOT current STREQUAL text)
        file(WRITE "${output}" "${text}")
    endif()
endfunction()
