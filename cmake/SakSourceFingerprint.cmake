# Build-bound evidence for native certification helpers. Hash both path and bytes so a
# renamed or changed input invalidates earlier proof. Paths are repository-relative.
function(_sak_source_fingerprint_tools python_output verifier_output)
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    get_filename_component(verifier
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/verify_source_fingerprint.py" ABSOLUTE)
    if(NOT EXISTS "${verifier}")
        message(FATAL_ERROR "Source fingerprint verifier is missing: ${verifier}")
    endif()
    set("${python_output}" "${Python3_EXECUTABLE}" PARENT_SCOPE)
    set("${verifier_output}" "${verifier}" PARENT_SCOPE)
endfunction()

function(sak_compute_source_fingerprint output_variable source_root)
    if(NOT IS_ABSOLUTE "${source_root}" OR NOT IS_DIRECTORY "${source_root}")
        message(FATAL_ERROR "Source fingerprint requires an absolute existing source root")
    endif()
    list(LENGTH ARGN fingerprint_input_count)
    if(fingerprint_input_count EQUAL 0)
        message(FATAL_ERROR "Source fingerprint requires a nonempty input list")
    endif()
    file(REAL_PATH "${source_root}" fingerprint_root)
    set(fingerprint_files)
    set(fingerprint_lexical_inputs "")
    foreach(input IN LISTS ARGN)
        get_filename_component(lexical "${input}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(lexical MATCHES "[\r\n]")
            message(FATAL_ERROR "Source fingerprint input has an ambiguous path")
        endif()
        string(APPEND fingerprint_lexical_inputs "${lexical}\n")
        file(REAL_PATH "${input}" resolved BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT EXISTS "${resolved}" OR IS_DIRECTORY "${resolved}")
            message(FATAL_ERROR "Source fingerprint input is missing or not a file: ${input}")
        endif()
        cmake_path(IS_PREFIX fingerprint_root "${resolved}" NORMALIZE inside_root)
        if(NOT inside_root)
            message(FATAL_ERROR "Source fingerprint input escapes source root: ${input}")
        endif()
        list(APPEND fingerprint_files "${resolved}")
    endforeach()
    list(REMOVE_DUPLICATES fingerprint_files)
    list(SORT fingerprint_files)
    # CMake REAL_PATH does not dereference Windows directory junctions reliably. Check the
    # original lexical ancestors through Windows file attributes before reading source bytes.
    _sak_source_fingerprint_tools(fingerprint_python fingerprint_verifier)
    string(SHA256 input_list_id "${source_root}|${fingerprint_lexical_inputs}")
    set(input_list "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/sak-source-${input_list_id}.inputs")
    file(WRITE "${input_list}" "${fingerprint_lexical_inputs}")
    execute_process(COMMAND "${fingerprint_python}" "${fingerprint_verifier}" check-paths
        --source-root "${source_root}" --paths-file "${input_list}"
        RESULT_VARIABLE path_check_result OUTPUT_VARIABLE path_check_output
        ERROR_VARIABLE path_check_error)
    if(NOT path_check_result EQUAL 0)
        message(FATAL_ERROR "Source fingerprint path check failed: ${path_check_output}${path_check_error}")
    endif()
    set(fingerprint_records "")
    set(fingerprint_header_records "")
    foreach(input IN LISTS fingerprint_files)
        file(RELATIVE_PATH relative "${fingerprint_root}" "${input}")
        if(relative MATCHES "[\r\n]")
            message(FATAL_ERROR "Source fingerprint input has an ambiguous path")
        endif()
        file(SHA256 "${input}" content_hash)
        string(SHA256 input_key "${input}")
        set("fingerprint_hash_${input_key}" "${content_hash}")
        string(APPEND fingerprint_records "${relative}:${content_hash}\n")
        string(TOLOWER "${input}" input_extension_path)
        if(input_extension_path MATCHES "\.(h|hpp|hxx|hh|inc|inl)$")
            string(APPEND fingerprint_header_records "${relative}:${content_hash}\n")
        endif()
    endforeach()
    # A header/source edit must trigger regeneration of the embedded stamp before the helper
    # is rebuilt. Merely computing it during the first configure would leave stale provenance.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        ${fingerprint_files} "${fingerprint_verifier}")
    string(SHA256 fingerprint "${fingerprint_records}")
    string(SHA256 header_fingerprint "${fingerprint_header_records}")
    set_property(GLOBAL PROPERTY "SAK_FINGERPRINT_${fingerprint}_FILES" "${fingerprint_files}")
    set_property(GLOBAL PROPERTY "SAK_FINGERPRINT_${fingerprint}_ROOT" "${fingerprint_root}")
    set_property(GLOBAL PROPERTY "SAK_FINGERPRINT_${fingerprint}_HEADERS" "${header_fingerprint}")
    foreach(input IN LISTS fingerprint_files)
        string(SHA256 input_key "${input}")
        set_property(GLOBAL PROPERTY "SAK_FINGERPRINT_${fingerprint}_FILE_${input_key}"
            "${fingerprint_hash_${input_key}}")
    endforeach()
    set("${output_variable}" "${fingerprint}" PARENT_SCOPE)
    set("${output_variable}_RECORDS" "${fingerprint_records}" PARENT_SCOPE)
endfunction()

function(_sak_bind_fingerprint_target target fingerprint fingerprint_files header_fingerprint bound_targets)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Source fingerprint target does not exist: ${target}")
    endif()
    get_target_property(imported "${target}" IMPORTED)
    if(imported)
        message(FATAL_ERROR "Source fingerprint cannot bind imported target: ${target}")
    endif()
    get_target_property(previous_headers "${target}" SAK_FINGERPRINT_HEADERS)
    if(previous_headers AND NOT previous_headers STREQUAL header_fingerprint)
        message(FATAL_ERROR "Conflicting source fingerprint header universes for ${target}")
    endif()
    if(NOT previous_headers)
        # Header digests also reach AUTOMOC. Reconfiguration after a backdated header edit
        # must rebuild real objects/generated metaobjects, not merely the reporting stamp.
        target_compile_definitions("${target}" PRIVATE
            SAK_SOURCE_FINGERPRINT_HEADERS_SHA256="${header_fingerprint}")
        set_property(TARGET "${target}" PROPERTY SAK_FINGERPRINT_HEADERS "${header_fingerprint}")
    endif()
    get_target_property(target_sources "${target}" SOURCES)
    get_target_property(target_source_dir "${target}" SOURCE_DIR)
    foreach(input IN LISTS target_sources)
        if(input MATCHES "^\\$<TARGET_OBJECTS:([^>]+)>$")
            if(NOT CMAKE_MATCH_1 IN_LIST bound_targets)
                message(FATAL_ERROR "Unbound fingerprint object target: ${CMAKE_MATCH_1}")
            endif()
            continue()
        endif()
        if(input MATCHES "\\$<")
            message(FATAL_ERROR "Unbound conditional fingerprint source: ${input}")
        endif()
        file(REAL_PATH "${input}" resolved BASE_DIRECTORY "${target_source_dir}")
        if(NOT resolved IN_LIST fingerprint_files)
            message(FATAL_ERROR "Target source is absent from fingerprint: ${input}")
        endif()
        string(TOLOWER "${resolved}" source_extension_path)
        if(source_extension_path MATCHES "\.(c|cc|cpp|cxx)$")
            string(SHA256 input_key "${resolved}")
            get_property(content_hash GLOBAL PROPERTY "SAK_FINGERPRINT_${fingerprint}_FILE_${input_key}")
            if(NOT content_hash)
                message(FATAL_ERROR "Missing source fingerprint compile binding: ${resolved}")
            endif()
            set_property(SOURCE "${resolved}" TARGET_DIRECTORY "${target}" APPEND PROPERTY
                COMPILE_DEFINITIONS SAK_SOURCE_FINGERPRINT_INPUT_SHA256="${content_hash}")
        endif()
    endforeach()
endfunction()

function(sak_add_source_fingerprint_guard target source_root manifest expected_fingerprint)
    get_property(fingerprint_files GLOBAL PROPERTY "SAK_FINGERPRINT_${expected_fingerprint}_FILES")
    get_property(fingerprint_root GLOBAL PROPERTY "SAK_FINGERPRINT_${expected_fingerprint}_ROOT")
    get_property(header_fingerprint GLOBAL PROPERTY "SAK_FINGERPRINT_${expected_fingerprint}_HEADERS")
    file(REAL_PATH "${source_root}" requested_root)
    if(NOT fingerprint_files OR NOT requested_root STREQUAL fingerprint_root)
        message(FATAL_ERROR "Source fingerprint build guard requires its configured input set")
    endif()
    _sak_source_fingerprint_tools(fingerprint_python fingerprint_verifier)
    if(NOT fingerprint_verifier IN_LIST fingerprint_files)
        message(FATAL_ERROR "Source fingerprint must include its verifier script as an input")
    endif()
    set(bound_targets "${target}" ${ARGN})
    list(REMOVE_DUPLICATES bound_targets)
    set(guard_target "${target}_source_fingerprint_check")
    if(TARGET "${guard_target}")
        message(FATAL_ERROR "Source fingerprint build guard already exists: ${guard_target}")
    endif()
    add_custom_target("${guard_target}"
        COMMAND "${fingerprint_python}" "${fingerprint_verifier}" verify
            --source-root "${source_root}" --manifest "${manifest}"
            --expected-sha256 "${expected_fingerprint}"
        VERBATIM)
    foreach(bound_target IN LISTS bound_targets)
        _sak_bind_fingerprint_target("${bound_target}" "${expected_fingerprint}"
            "${fingerprint_files}" "${header_fingerprint}" "${bound_targets}")
        add_dependencies("${bound_target}" "${guard_target}")
    endforeach()
endfunction()
