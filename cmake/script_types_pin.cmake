#
# Run with cmake -P when sak_script_types.dll is built: write its SHA-256 for
# sak::program_integrity, which accepts that DLL in an unsigned build only with exactly these bytes
# (a release signs it and the same-signer rule takes over). The .NET Framework compiler is not
# deterministic, so the hash is taken from the DLL this build made, every time it makes one.
#
#   -DSAK_FILE=<sak_script_types.dll> -DSAK_OUTPUT=<script_types_pin.inc>

if(NOT EXISTS "${SAK_FILE}")
    message(FATAL_ERROR "script_types_pin: ${SAK_FILE} was not built")
endif()
file(SHA256 "${SAK_FILE}" _sak_hash)
set(_sak_content "// Generated by cmake/script_types_pin.cmake when sak_script_types.dll is built.\n")
string(APPEND _sak_content "constexpr std::string_view kScriptTypesSha256 = \"${_sak_hash}\";\n")
# Written every time (never "only if different"): the rule that builds the DLL reruns when an
# output is older than a source, and a pin left with an old date would rebuild the DLL every build.
file(WRITE "${SAK_OUTPUT}" "${_sak_content}")
