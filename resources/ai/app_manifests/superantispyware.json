{
  "schema_version": 1,
  "id": "superantispyware",
  "display_name": "SUPERAntiSpyware",
  "providers": [
    "win32_mcp",
    "vendor_docs",
    "filesystem",
    "package_metadata"
  ],
  "detect": {
    "registry_display_name": "SUPERAntiSpyware",
    "publisher": "RealDefense",
    "default_executable": "C:\\Program Files\\SUPERAntiSpyware\\SUPERAntiSpyware.exe",
    "process_names": [
      "SUPERAntiSpyware.exe",
      "SASCore64.exe"
    ]
  },
  "notes": "Free edition has no scan CLI; the validated control path is the GUI via the win32 desktop-control engine. Recipes below are win32_gui: an ordered list of desktop-control tool steps the step runner drives (plan -> per-step risk check -> execute over the win32 stdio pipe). Preconditions: SUPERAntiSpyware.exe is already running and showing its main (home) window. The engine raises the window before each click, so it need not be foreground. The main UI is custom-drawn: nav tiles and some buttons expose no UI Automation name, so recipes use OCR whole-word click_text; scan/update completion pops a title-less modal, read with foreground=true. optional:true steps tolerate a label that is not present. MODERN SCAN = run definition_update first, then quick_scan/full_scan: the scan page's 'Check for malware database updates' pre-scan option is a PRO-locked feature in the free edition (clicking it pops a 'Professional Feature Unavailable' dialog), so defs cannot be refreshed inside the scan itself. Both scan and update completion leave an OK dialog on a nameless custom button -- dismiss it with uia_inspect_window(foreground) + uia_click_control by ref (the ref is not stable across screens).",
  "actions": {
    "quick_scan": {
      "supported": true,
      "method": "win32_gui",
      "timeout_seconds": 7200,
      "steps": [
        {"tool": "focus_window", "arguments": {"window_title": "SUPERAntiSpyware"}},
        {"tool": "click_text", "arguments": {"text": "Scan This Computer", "window_title": "SUPERAntiSpyware"}},
        {"tool": "wait_for_idle", "arguments": {"window_title": "SUPERAntiSpyware", "timeout_ms": 8000}},
        {"tool": "click_text", "arguments": {"text": "Quick Scan", "window_title": "SUPERAntiSpyware"}},
        {"tool": "wait_for_text", "timeout_ms": 1800000, "arguments": {"text": "Scan Results", "foreground": true, "timeout_ms": 1800000, "poll_ms": 3000}},
        {"tool": "ocr_window", "arguments": {"foreground": true}}
      ],
      "evidence": [
        "Items Detected",
        "Scan Results"
      ]
    },
    "full_scan": {
      "supported": true,
      "method": "win32_gui",
      "timeout_seconds": 14400,
      "steps": [
        {"tool": "focus_window", "arguments": {"window_title": "SUPERAntiSpyware"}},
        {"tool": "click_text", "arguments": {"text": "Scan This Computer", "window_title": "SUPERAntiSpyware"}},
        {"tool": "wait_for_idle", "arguments": {"window_title": "SUPERAntiSpyware", "timeout_ms": 8000}},
        {"tool": "click_text", "arguments": {"text": "Complete Scan", "window_title": "SUPERAntiSpyware"}},
        {"tool": "wait_for_text", "timeout_ms": 7200000, "arguments": {"text": "Scan Results", "foreground": true, "timeout_ms": 7200000, "poll_ms": 5000}},
        {"tool": "ocr_window", "arguments": {"foreground": true}}
      ],
      "evidence": [
        "Items Detected",
        "Scan Results"
      ]
    },
    "definition_update": {
      "supported": true,
      "method": "win32_gui",
      "timeout_seconds": 1800,
      "steps": [
        {"tool": "focus_window", "arguments": {"window_title": "SUPERAntiSpyware"}},
        {"tool": "click_text", "arguments": {"text": "check for", "window_title": "SUPERAntiSpyware"}},
        {"tool": "wait_for_idle", "timeout_ms": 300000, "arguments": {"window_title": "SUPERAntiSpyware", "timeout_ms": 300000, "idle_ms": 3000}},
        {"tool": "wait_for_text", "timeout_ms": 900000, "arguments": {"text": "Complete", "foreground": true, "timeout_ms": 900000, "poll_ms": 3000}},
        {"tool": "ocr_window", "arguments": {"foreground": true}}
      ],
      "evidence": [
        "Complete"
      ]
    }
  }
}
