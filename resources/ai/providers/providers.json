{
  "schema_version": 1,
  "providers": [
    {
      "id": "microsoft_docs",
      "name": "Microsoft Learn MCP",
      "kind": "docs",
      "transport": "http",
      "endpoint": "https://learn.microsoft.com/api/mcp",
      "enabled": true,
      "portable_config": true,
      "requires_network": true,
      "requires_local_bundle": false,
      "requires_auth": false,
      "terms_url": "https://learn.microsoft.com/en-us/legal/termsofuse",
      "tools": [
        "microsoft_docs_search",
        "microsoft_docs_fetch",
        "microsoft_code_sample_search"
      ],
      "capabilities": [
        "docs_search",
        "docs_fetch",
        "code_sample_search"
      ],
      "policy": "read_only"
    },
    {
      "id": "context7",
      "name": "Context7 MCP",
      "kind": "docs",
      "transport": "http",
      "endpoint": "https://mcp.context7.com/mcp",
      "enabled": true,
      "portable_config": true,
      "requires_network": true,
      "requires_local_bundle": false,
      "requires_auth": false,
      "auth_mode": "none",
      "license": "MIT",
      "source_url": "https://github.com/upstash/context7",
      "tools": [
        "resolve-library-id",
        "query-docs"
      ],
      "capabilities": [
        "library_resolution",
        "versioned_docs"
      ],
      "policy": "read_only"
    },
    {
      "id": "win32_mcp",
      "name": "Win32 MCP Server",
      "kind": "desktop_automation",
      "transport": "stdio",
      "command": "sak_utility.exe",
      "enabled": true,
      "portable_config": true,
      "requires_network": false,
      "requires_local_bundle": true,
      "license": "AGPL-3.0-or-later",
      "source_url": "built-in (src/win32mcp)",
      "tools": [
        "health_check",
        "list_windows",
        "get_window_info",
        "list_monitors",
        "mouse_position",
        "clipboard_read",
        "clipboard_write",
        "browser_navigate",
        "browser_snapshot",
        "browser_read",
        "browser_back",
        "browser_forward",
        "browser_reload",
        "browser_screenshot",
        "browser_click",
        "browser_click_at",
        "browser_hover",
        "browser_drag",
        "browser_type",
        "browser_select",
        "browser_set_value",
        "browser_media",
        "browser_press_key",
        "browser_scroll",
        "browser_dialog",
        "browser_tabs",
        "browser_select_tab",
        "browser_new_tab",
        "browser_close_tab",
        "browser_group_tabs",
        "browser_ungroup_tabs",
        "browser_wait_for",
        "browser_get_value",
        "browser_get_attribute",
        "browser_box",
        "browser_focus",
        "browser_reveal",
        "browser_js_click",
        "browser_windows",
        "browser_window",
        "browser_emulate",
        "browser_print",
        "browser_permission",
        "browser_storage",
        "browser_cookies",
        "browser_download",
        "browser_http_auth",
        "browser_extension_install",
        "browser_extension_uninstall",
        "browser_extension_status"
      ],
      "capabilities": [
        "window_observation",
        "browser_control",
        "clipboard",
        "mouse_keyboard"
      ],
      "policy": "manifest_gated_mutation",
      "environment": {
        "SAK_WIN32_MCP_MODE": "1",
        "WIN32_MCP_SECURITY_PROFILE": "interactive",
        "WIN32_MCP_RESULT_ENVELOPE": "true",
        "WIN32_MCP_REDACT_SENSITIVE_OUTPUT": "true"
      }
    },
    {
      "id": "github",
      "name": "GitHub Provider",
      "kind": "source_research",
      "transport": "planned",
      "enabled": false,
      "portable_config": true,
      "requires_network": true,
      "requires_local_bundle": false,
      "capabilities": [
        "release_notes",
        "issues",
        "repository_files"
      ],
      "policy": "read_only_default"
    },
    {
      "id": "filesystem",
      "name": "SAK Filesystem Provider",
      "kind": "local_evidence",
      "transport": "native",
      "enabled": true,
      "portable_config": true,
      "requires_network": false,
      "requires_local_bundle": false,
      "capabilities": [
        "bounded_read",
        "bounded_search",
        "artifact_collection"
      ],
      "policy": "workspace_or_artifact_scoped"
    },
    {
      "id": "browser",
      "name": "Browser Automation Provider",
      "kind": "web_automation",
      "transport": "planned",
      "enabled": false,
      "portable_config": true,
      "requires_network": true,
      "requires_local_bundle": true,
      "capabilities": [
        "vendor_portal_navigation",
        "js_docs_capture"
      ],
      "policy": "evidence_gated_mutation"
    },
    {
      "id": "vendor_docs",
      "name": "Vendor Documentation Provider",
      "kind": "docs",
      "transport": "native",
      "enabled": true,
      "portable_config": true,
      "requires_network": true,
      "requires_local_bundle": false,
      "capabilities": [
        "vendor_doc_search",
        "control_method_evidence"
      ],
      "policy": "read_only"
    },
    {
      "id": "package_metadata",
      "name": "Package Metadata Provider",
      "kind": "package_research",
      "transport": "native",
      "enabled": true,
      "portable_config": true,
      "requires_network": true,
      "requires_local_bundle": false,
      "capabilities": [
        "chocolatey",
        "winget",
        "github_releases",
        "checksum_evidence"
      ],
      "policy": "read_only_default"
    },
    {
      "id": "security_reputation",
      "name": "Security Reputation Provider",
      "kind": "file_reputation",
      "transport": "planned",
      "enabled": false,
      "portable_config": true,
      "requires_network": true,
      "requires_local_bundle": false,
      "capabilities": [
        "hash_reputation",
        "signature_evidence"
      ],
      "policy": "privacy_gated"
    }
  ]
}
